generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops     Shop[]
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  description String?
  phone       String?
  email       String?
  address     String
  city        String
  state       String
  pincode     String

  /// 24h "HH:mm" shop opening time (default 09:00 AM)
  openTime    String   @default("09:00")
  /// 24h "HH:mm" shop closing time (default 08:00 PM)
  closeTime   String   @default("20:00")
  /// 24h "HH:mm" lunch break start (default 01:00 PM)
  lunchStart  String   @default("13:00")
  /// 24h "HH:mm" lunch break end (default 02:00 PM)
  lunchEnd    String   @default("14:00")

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  holidays    ShopHoliday[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopHoliday {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Calendar date only (no time)
  date      DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId])
}

enum UserRole {
  CUSTOMER
  BARBER
  ADMIN
}