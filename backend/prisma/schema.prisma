generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String?  @unique
  password      String
  role          UserRole @default(CUSTOMER)
  /// Public profile photo path (e.g. /uploads/profiles/…)
  photoUrl      String?
  /// Must verify email OTP after register before login is allowed.
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shops         Shop[]
  appointments  Appointment[]
  notifications Notification[]
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// Optional deep-link hint for the app (e.g. /history, /barber/appointments)
  href      String?
  /// Related appointment id when applicable
  appointmentId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  purpose    OtpPurpose
  /// bcrypt hash of the 6-digit code
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  description String?
  phone       String?
  email       String?
  address     String
  city        String
  state       String
  pincode     String
  /// Public shop cover photo path (e.g. /uploads/shops/…)
  photoUrl    String?

  /// 24h "HH:mm" shop opening time (default 09:00 AM)
  openTime    String   @default("09:00")
  /// 24h "HH:mm" shop closing time (default 08:00 PM)
  closeTime   String   @default("20:00")
  /// 24h "HH:mm" lunch break start (default 01:00 PM)
  lunchStart  String   @default("13:00")
  /// 24h "HH:mm" lunch break end (default 02:00 PM)
  lunchEnd    String   @default("14:00")

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  /// Opaque token embedded in the shop's static arrival QR (not the shop UUID).
  qrToken     String   @unique @default(uuid())
  holidays     ShopHoliday[]
  staff        ShopStaff[]
  services     ShopService[]
  appointments Appointment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopHoliday {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Calendar date only (no time)
  date      DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId])
}

model ShopService {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  /// Price in INR rupees (whole units)
  priceInr    Int
  /// Typical duration in minutes (used for display; walk-in slot still uses pressed slot)
  durationMin Int      @default(30)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId, active])
}

model ShopStaff {
  id              String      @id @default(uuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  title           String
  phone           String
  status          StaffStatus @default(ACTIVE)
  /// Calendar date only (when status is ON_LEAVE)
  leaveReturnDate DateTime?   @db.Date
  /// Wall-clock return instant (when status is AWAY). Compared to slot date+HH:mm as UTC components.
  awayUntil       DateTime?
  appointments    Appointment[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([shopId])
}

model Appointment {
  id            String            @id @default(uuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Registered customer who owns this booking. Null for barber-created
  /// walk-ins, where `customerName` is the only customer identity we have.
  customerId    String?
  customer      User?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  serviceName   String
  /// Null means "Any Available"
  staffId       String?
  staff         ShopStaff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  /// Price in INR rupees (whole units)
  priceInr      Int
  status        AppointmentStatus @default(PENDING)
  /// Calendar date only
  date          DateTime          @db.Date
  /// 24h "HH:mm" start
  startTime     String
  /// 24h "HH:mm" end
  endTime       String
  isWalkIn      Boolean           @default(false)

  /// Server time when customer arrival was verified at the shop.
  arrivedAt                 DateTime?
  /// Server time when barber verified service start via customer QR.
  actualStartAt             DateTime?
  /// Single-use jti for the current service-start QR (null when none issued).
  serviceStartQrJti         String?   @unique
  serviceStartQrExpiresAt   DateTime?
  serviceStartQrConsumedAt  DateTime?

  /// Idempotent scoring fields (set once when COMPLETED + actualStartAt).
  basePoints         Int?
  punctualityPoints  Int?
  bookingScore       Int?
  scoredAt           DateTime?

  arrival            AppointmentArrival?
  verificationAudits VerificationAuditLog[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([shopId, date])
  @@index([shopId, status])
  @@index([staffId])
  @@index([customerId, date])
  @@index([staffId, actualStartAt])
  @@index([scoredAt])
}

/// One arrival verification per booking (prevents duplicate arrival records).
model AppointmentArrival {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerId    String
  shopId        String
  /// Server timestamp of successful arrival verification
  arrivedAt     DateTime @default(now())
  status        String   @default("VERIFIED")

  createdAt     DateTime @default(now())

  @@index([shopId, arrivedAt])
  @@index([customerId])
}

model VerificationAuditLog {
  id            String   @id @default(uuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  shopId        String?
  actorUserId   String?
  /// ARRIVAL_SCAN | SERVICE_START_SCAN
  action        String
  success       Boolean
  detail        String?
  createdAt     DateTime @default(now())

  @@index([appointmentId, createdAt])
  @@index([shopId, createdAt])
}

enum UserRole {
  CUSTOMER
  BARBER
  ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum StaffStatus {
  ACTIVE
  AWAY
  ON_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}