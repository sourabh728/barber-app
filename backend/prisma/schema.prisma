generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String?  @unique
  password      String
  role          UserRole @default(CUSTOMER)
  /// Must verify email OTP after register before login is allowed.
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shops     Shop[]
  appointments Appointment[]
}

model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  purpose    OtpPurpose
  /// bcrypt hash of the 6-digit code
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  description String?
  phone       String?
  email       String?
  address     String
  city        String
  state       String
  pincode     String

  /// 24h "HH:mm" shop opening time (default 09:00 AM)
  openTime    String   @default("09:00")
  /// 24h "HH:mm" shop closing time (default 08:00 PM)
  closeTime   String   @default("20:00")
  /// 24h "HH:mm" lunch break start (default 01:00 PM)
  lunchStart  String   @default("13:00")
  /// 24h "HH:mm" lunch break end (default 02:00 PM)
  lunchEnd    String   @default("14:00")

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  holidays     ShopHoliday[]
  staff        ShopStaff[]
  appointments Appointment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShopHoliday {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Calendar date only (no time)
  date      DateTime @db.Date

  createdAt DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId])
}

model ShopStaff {
  id              String      @id @default(uuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  title           String
  phone           String
  status          StaffStatus @default(ACTIVE)
  /// Calendar date only (when status is ON_LEAVE)
  leaveReturnDate DateTime?   @db.Date
  appointments    Appointment[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([shopId])
}

model Appointment {
  id            String            @id @default(uuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Registered customer who owns this booking. Null for barber-created
  /// walk-ins, where `customerName` is the only customer identity we have.
  customerId    String?
  customer      User?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  serviceName   String
  /// Null means "Any Available"
  staffId       String?
  staff         ShopStaff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  /// Price in INR rupees (whole units)
  priceInr      Int
  status        AppointmentStatus @default(PENDING)
  /// Calendar date only
  date          DateTime          @db.Date
  /// 24h "HH:mm" start
  startTime     String
  /// 24h "HH:mm" end
  endTime       String
  isWalkIn      Boolean           @default(false)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([shopId, date])
  @@index([shopId, status])
  @@index([staffId])
  @@index([customerId, date])
}

enum UserRole {
  CUSTOMER
  BARBER
  ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}