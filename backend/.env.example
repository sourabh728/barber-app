DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=604800

# Comma-separated Google OAuth client IDs used as ID token audiences.
# Include the Web client ID and any iOS/Android client IDs the app uses.
GOOGLE_CLIENT_IDS="xxxxx.apps.googleusercontent.com,yyyyy.apps.googleusercontent.com"

# Optional aliases if you prefer separate variables instead of GOOGLE_CLIENT_IDS
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
