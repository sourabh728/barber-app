DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=315360000

# Gmail SMTP (works on local Nest). Render free tier often blocks ports 587/465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trimshim <you@gmail.com>"

# Comma-separated Google OAuth client IDs used as ID token audiences.
# Include the Web client ID and any iOS/Android client IDs the app uses.
GOOGLE_CLIENT_IDS="xxxxx.apps.googleusercontent.com,yyyyy.apps.googleusercontent.com"

# Optional aliases if you prefer separate variables instead of GOOGLE_CLIENT_IDS
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
