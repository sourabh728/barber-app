# Optional. On Android emulators, localhost is rewritten to 10.0.2.2.
# Physical devices should use your machine LAN IP, e.g. http://192.168.1.37:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth client IDs from Google Cloud Console.
# Do not put a client_secret in this app.
#
# Web (press w in the Expo terminal) uses the Web client with response_type=id_token.
# Web client authorized JavaScript origins:
#   http://localhost:8081
# Web client authorized redirect URIs:
#   http://localhost:8081
#   http://localhost:8081/
# Remove any auth.expo.io origins or redirects. That proxy is deprecated and fails.
#
# Expo Go cannot complete Google login. Use web, or a development build:
#   npx expo run:android
# Android/iOS development builds need native OAuth clients (not the Web client):
#   Package / bundle ID: com.barberapp1.app
#   Debug SHA-1 (Windows):
#     keytool -list -v -keystore %USERPROFILE%\.android\debug.keystore -alias androiddebugkey -storepass android -keypass android
# Put those native client IDs below, and also add them to backend GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
